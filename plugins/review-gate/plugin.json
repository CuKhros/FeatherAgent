{
  "manifest": {
    "name": "review-gate",
    "version": "1.2.1-rc.3",
    "api": ">=1.0 <2.0",
    "capabilities": [
      "loop.review-gate",
      "review.guide",
      "review.judge"
    ],
    "permissions": [],
    "category": "loop",
    "settings": {
      "root": "review_gate",
      "title": "三段校验 review-gate",
      "description": "guide 只写可核对的判据，exec 看不到判据，judge 先做字面硬校验再引用答案原文。默认关闭，属实验特性。",
      "fields": [
        {
          "key": "enabled",
          "label": "启用三段校验",
          "type": "bool",
          "default": false,
          "description": "开启后每个回合先产出判据，未通过时带判据与证据重答。"
        },
        {
          "key": "max_rounds",
          "label": "最大修订轮次",
          "type": "int",
          "default": 2,
          "min": 1,
          "max": 5,
          "step": 1,
          "description": "达到上限仍未通过时返回最后一版，状态记为 unapproved。"
        },
        {
          "key": "guide.model",
          "label": "Guide 模型",
          "type": "string",
          "default": "",
          "placeholder": "留空跟随当前模型",
          "description": "产出判据的模型，建议 ≥7B。"
        },
        {
          "key": "guide.temperature",
          "label": "Guide 温度",
          "type": "number",
          "default": 0.3,
          "min": 0.2,
          "max": 0.5,
          "step": 0.05
        },
        {
          "key": "exec.model",
          "label": "Exec 模型",
          "type": "string",
          "default": "",
          "placeholder": "留空跟随当前模型"
        },
        {
          "key": "exec.temperature",
          "label": "Exec 温度",
          "type": "number",
          "default": 0.7,
          "min": 0.6,
          "max": 1.5,
          "step": 0.05
        },
        {
          "key": "judge.model",
          "label": "Judge 模型",
          "type": "string",
          "default": "",
          "placeholder": "留空跟随当前模型",
          "description": "判通过与否的模型，建议 ≥7B。"
        },
        {
          "key": "judge.temperature",
          "label": "Judge 温度",
          "type": "number",
          "default": 0.1,
          "min": 0.0,
          "max": 0.2,
          "step": 0.05
        },
        {
          "key": "on_exhausted",
          "label": "轮次用尽",
          "type": "enum",
          "default": "return_last_with_flag",
          "options": [
            "return_last_with_flag"
          ]
        }
      ]
    }
  },
  "program": "../../feather-plugin",
  "args": [
    "review-gate"
  ]
}
