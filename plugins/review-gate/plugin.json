{
  "manifest": {
    "name": "review-gate",
    "version": "1.2.1-rc.4.6",
    "api": ">=1.0 <2.0",
    "capabilities": [
      "loop.review-gate",
      "review.guide",
      "review.judge"
    ],
    "permissions": [],
    "category": "loop",
    "settings": {
      "root": "review_gate",
      "title": "三段校验 review-gate",
      "description": "guide 只写可核对的判据，exec 看不到判据，judge 先做字面硬校验再引用答案原文。默认关闭，属实验特性。",
      "fields": [
        {
          "key": "enabled",
          "label": "启用三段校验",
          "type": "bool",
          "default": false,
          "description": "开启后每个回合先产出判据，未通过时带判据与证据重答。"
        },
        {
          "key": "max_rounds",
          "label": "最大修订轮次",
          "type": "int",
          "default": 2,
          "min": 1,
          "max": 5,
          "step": 1,
          "description": "达到上限仍未通过时返回最后一版，状态记为 unapproved。"
        },
        {
          "key": "guide.model",
          "label": "Guide 模型",
          "type": "string",
          "default": "",
          "placeholder": "留空跟随当前模型",
          "description": "产出判据的模型，建议 ≥7B。 下拉列表来自本地模型服务（provider.models），也可手动填写。",
          "options_source": "models",
          "allow_custom": true
        },
        {
          "key": "guide.temperature",
          "label": "Guide 温度",
          "type": "number",
          "default": 0.3,
          "min": 0.2,
          "max": 0.5,
          "step": 0.05
        },
        {
          "key": "exec.model",
          "label": "Exec 模型",
          "type": "string",
          "default": "",
          "placeholder": "留空跟随当前模型",
          "options_source": "models",
          "allow_custom": true,
          "description": "下拉列表来自本地模型服务（provider.models），也可手动填写。"
        },
        {
          "key": "exec.temperature",
          "label": "Exec 温度",
          "type": "number",
          "default": 0.7,
          "min": 0.6,
          "max": 1.5,
          "step": 0.05
        },
        {
          "key": "judge.model",
          "label": "Judge 模型",
          "type": "string",
          "default": "",
          "placeholder": "留空跟随当前模型",
          "description": "判通过与否的模型，建议 ≥7B。 下拉列表来自本地模型服务（provider.models），也可手动填写。",
          "options_source": "models",
          "allow_custom": true
        },
        {
          "key": "judge.temperature",
          "label": "Judge 温度",
          "type": "number",
          "default": 0.1,
          "min": 0.0,
          "max": 0.2,
          "step": 0.05
        },
        {
          "key": "criteria_routing",
          "label": "判据分流",
          "type": "enum",
          "default": "auto",
          "options": [
            "auto",
            "hardcheck_only",
            "judge_only"
          ],
          "description": "auto：字面/禁词/计数/正则判据由 hardcheck 判定，只有描述型判据交 judge；hardcheck_only：完全不用模型 judge；judge_only：旧行为，全部交 judge（调试用）。"
        },
        {
          "key": "hardcheck.pattern_engine",
          "label": "pattern 引擎",
          "type": "enum",
          "default": "glob",
          "options": [
            "glob",
            "regex"
          ],
          "description": "glob 兼容旧判据；regex 把 pattern 按正则解释。独立的 regex 判据始终按正则执行。"
        },
        {
          "key": "judge.votes",
          "label": "Judge 票数",
          "type": "int",
          "default": 1,
          "min": 1,
          "max": 3,
          "step": 2,
          "description": "1 或 3。大于 1 时串行投票，按 majority 聚合；峰值模型并发仍为 1。"
        },
        {
          "key": "judge.aggregation",
          "label": "票数聚合",
          "type": "enum",
          "default": "majority",
          "options": [
            "majority"
          ],
          "description": "只支持 majority（禁止 all/AND）；多数票通过才算通过。"
        },
        {
          "key": "judge.early_stop_on_agreement",
          "label": "两票一致即收敛",
          "type": "bool",
          "default": true,
          "description": "开启时前两票逐项一致就跳过第三票，节省调用。"
        },
        {
          "key": "on_exhausted",
          "label": "轮次用尽",
          "type": "enum",
          "default": "return_last_with_flag",
          "options": [
            "return_last_with_flag"
          ]
        }
      ]
    }
  },
  "program": "../../feather-plugin",
  "args": [
    "review-gate"
  ]
}
